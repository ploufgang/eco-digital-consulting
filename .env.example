# URL publique finale. Les espaces, slash terminal et domaine sans protocole sont normalisés.
# Si elle est vide ou invalide sur Vercel, VERCEL_PROJECT_PRODUCTION_URL puis le domaine par défaut sont utilisés.
NEXT_PUBLIC_SITE_URL=https://ecodigital-consulting.example

# URL complète de l’événement, par exemple https://cal.com/votre-compte/diagnostic-30-min
NEXT_PUBLIC_CALCOM_URL=

# Utilisées uniquement dans le Route Handler serveur
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
